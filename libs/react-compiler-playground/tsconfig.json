{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["react/experimental", "node"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "sourceMap": true,
    "declarationMap": true,
    "declaration": true
  },
  "include": ["src"]
}
